# Jetbox Environment Variables

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# Home Assistant Configuration (for smart_home_controller agent)
# Get your long-lived access token from:
# Home Assistant -> Profile -> Long-Lived Access Tokens -> Create Token
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=your_long_lived_access_token_here

# Gmail Configuration (for future email_scanner agent)
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your_app_password

# Google Calendar Configuration (for future email_scanner agent)
# GOOGLE_CALENDAR_CREDENTIALS_PATH=/path/to/credentials.json

# Agent Manager Configuration
# JETBOX_STATE_DIR=/path/to/.jetbox
# JETBOX_LOG_DIR=/path/to/.jetbox/logs
