def test_docker_start_container_success(docker_behavior):
    """Test that starting a container succeeds and updates internal state."""
    # Arrange
    mock_container = MagicMock()
    mock_container.name = "test_container"
    mock_container.status = "running"
    docker_behavior.client.containers.run.return_value = mock_container

    # Act
    result = docker_behavior.docker_start_container(image="busybox", name="test_container")

    # Assert
    docker_behavior.client.containers.run.assert_called_once_with(
        "busybox", name="test_container", detach=True
    )
    assert result["name"] == "test_container"
    assert result["status"] == "running"
    # Verify that the container is tracked internally (assuming a `tracked_containers` dict)
    assert "test_container" in docker_behavior.tracked_containers
    assert docker_behavior.tracked_containers["test_container"]["status"] == "running"


def test_docker_start_container_error_invalid_image(docker_behavior):
    """Test that starting a container with an invalid image raises an error."""
    # Arrange
    from docker.errors import ImageNotFound
    docker_behavior.client.containers.run.side_effect = ImageNotFound("Image not found")

    # Act & Assert
    with pytest.raises(ImageNotFound, match="Image not found"):
        docker_behavior.docker_start_container(image="nonexistent_image", name="bad_container")
    # Ensure no container was tracked
    assert "bad_container" not in docker_behavior.tracked_containers


def test_docker_stop_container_success(docker_behavior):
    """Test that stopping a running container succeeds and updates state."""
    # Arrange
    mock_container = MagicMock()
    mock_container.name = "running_container"
    mock_container.status = "running"
    docker_behavior.client.containers.get.return_value = mock_container

    # Pre-populate tracked containers
    docker_behavior.tracked_containers["running_container"] = {"status": "running"}

    # Act
    result = docker_behavior.docker_stop_container(name="running_container")

    # Assert
    docker_behavior.client.containers.get.assert_called_once_with("running_container")
    mock_container.stop.assert_called_once()
    assert result["name"] == "running_container"
    assert result["status"] == "exited"
    # Verify internal state updated
    assert docker_behavior.tracked_containers["running_container"]["status"] == "exited"


def test_docker_stop_container_error_not_found(docker_behavior):
    """Test that stopping a non-existent container raises an error."""
    # Arrange
    from docker.errors import NotFound
    docker_behavior.client.containers.get.side_effect = NotFound("Container not found")

    # Act & Assert
    with pytest.raises(NotFound, match="Container not found"):
        docker_behavior.docker_stop_container(name="missing_container")
    # Ensure no state change
    assert "missing_container" not in docker_behavior.tracked_containers


def test_docker_list_containers_success(docker_behavior):
    """Test that listing containers returns the correct tracked containers."""
    # Arrange
    mock_container1 = MagicMock()
    mock_container1.name = "c1"
    mock_container1.status = "running"
    mock_container2 = MagicMock()
    mock_container2.name = "c2"
    mock_container2.status = "exited"

    docker_behavior.client.containers.list.return_value = [mock_container1, mock_container2]

    # Act
    result = docker_behavior.docker_list_containers()

    # Assert
    docker_behavior.client.containers.list.assert_called_once()
    assert isinstance(result, list)
    assert len(result) == 2
    names = {c["name"] for c in result}
    statuses = {c["status"] for c in result}
    assert names == {"c1", "c2"}
    assert statuses == {"running", "exited"}


def test_docker_list_containers_error(docker_behavior):
    """Test that an error during listing containers propagates correctly."""
    from docker.errors import APIError
    docker_behavior.client.containers.list.side_effect = APIError("API failure")

    with pytest.raises(APIError, match="API failure"):
        docker_behavior.docker_list_containers()
    # No containers should be returned
    docker_behavior.client.containers.list.assert_called_once()
    # Ensure internal state remains unchanged
    assert docker_behavior.tracked_containers == {}