def test_docker_list_containers_success(mock_docker_client):
    """
    Test that DockerBehavior.docker_list_containers returns a list of
    container status dictionaries when the Docker API call succeeds.
    """
    # Arrange
    behavior = DockerBehavior()

    # Create mock containers
    mock_container1 = MagicMock()
    mock_container1.attrs = {"Name": "c1", "State": {"Status": "running"}}
    mock_container2 = MagicMock()
    mock_container2.attrs = {"Name": "c2", "State": {"Status": "exited"}}

    mock_docker_client.containers.list.return_value = [mock_container1, mock_container2]

    # Act
    result = behavior.docker_list_containers()

    # Assert
    mock_docker_client.containers.list.assert_called_once_with(all=True)
    assert isinstance(result, list)
    assert len(result) == 2
    assert result[0]["name"] == "c1"
    assert result[0]["status"] == "running"
    assert result[1]["name"] == "c2"
    assert result[1]["status"] == "exited"


def test_docker_list_containers_error(mock_docker_client):
    """
    Test that DockerBehavior.docker_list_containers propagates an exception
    when the Docker API call fails.
    """
    # Arrange
    behavior = DockerBehavior()

    # Configure the mock to raise an APIError
    mock_docker_client.containers.list.side_effect = docker.errors.APIError("List failed")

    # Act & Assert
    with pytest.raises(docker.errors.APIError):
        behavior.docker_list_containers()