def test_docker_start_container_success(mock_docker_client):
    """
    Test that DockerBehavior.docker_start_container starts a container
    and returns the expected result when the Docker API call succeeds.
    """
    # Arrange
    behavior = DockerBehavior()
    image = "nginx:latest"
    name = "test_container"

    # Mock the container returned by the Docker client
    mock_container = MagicMock()
    mock_container.attrs = {"Name": name, "State": {"Status": "running"}}
    mock_docker_client.containers.run.return_value = mock_container

    # Act
    result = behavior.docker_start_container(image=image, name=name)

    # Assert
    mock_docker_client.containers.run.assert_called_once_with(
        image, name=name, detach=True
    )
    assert isinstance(result, dict)
    assert result.get("name") == name
    assert result.get("status") == "running"


def test_docker_start_container_error(mock_docker_client):
    """
    Test that DockerBehavior.docker_start_container propagates an exception
    when the Docker API call fails.
    """
    # Arrange
    behavior = DockerBehavior()
    image = "nginx:latest"
    name = "test_container"

    # Configure the mock to raise an APIError
    mock_docker_client.containers.run.side_effect = docker.errors.APIError("Start failed")

    # Act & Assert
    with pytest.raises(docker.errors.APIError):
        behavior.docker_start_container(image=image, name=name)


def test_docker_stop_container_success(mock_docker_client):
    """
    Test that DockerBehavior.docker_stop_container stops a running container
    and returns the expected result when the Docker API call succeeds.
    """
    # Arrange
    behavior = DockerBehavior()
    name = "test_container"

    # Mock the container returned by get
    mock_container = MagicMock()
    mock_docker_client.containers.get.return_value = mock_container

    # Act
    result = behavior.docker_stop_container(name=name)

    # Assert
    mock_docker_client.containers.get.assert_called_once_with(name)
    mock_container.stop.assert_called_once()
    assert isinstance(result, dict)
    assert result.get("name") == name
    assert result.get("status") == "stopped"


