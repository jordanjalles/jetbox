"""
DockerBehavior provides Docker container management with persistent state tracking.
"""

from typing import Any
import os
import json
import subprocess
import uuid

from behaviors.base import AgentBehavior


class DockerBehavior(AgentBehavior):
    """
    Provides Docker container management with persistent state tracking.

    This behavior offers tools to start, stop, and list Docker containers,
    maintaining an internal state of container IDs and statuses across
    agent restarts.
    """

    def __init__(self, workspace_manager=None, **kwargs):
        """
        Initialize behavior.

        Args:
            workspace_manager: Optional WorkspaceManager for file path resolution
            **kwargs: Additional parameters (ignored for extensibility)
        """
        super().__init__(workspace_manager=workspace_manager, **kwargs)
        self.workspace_manager = workspace_manager
        self.containers: dict[str, dict[str, str]] = {}
        self._state_file = self._get_state_file_path()

    def _get_state_file_path(self) -> str:
        """
        Determine the file path for persisting container state.
        """
        if self.workspace_manager and hasattr(self.workspace_manager, "get_path"):
            return self.workspace_manager.get_path("docker_behavior_state.json")
        return os.path.join(os.getcwd(), "docker_behavior_state.json")

    def _load_state(self):
        """
        Load container state from the persistence file.
        """
        try:
            if os.path.exists(self._state_file):
                with open(self._state_file, "r", encoding="utf-8") as f:
                    self.containers = json.load(f)
            else:
                self.containers = {}
        except Exception as e:
            # If loading fails, start with empty state
            self.containers = {}

    def _save_state(self):
        """
        Save container state to the persistence file.
        """
        try:
            with open(self._state_file, "w", encoding="utf-8") as f:
                json.dump(self.containers, f, indent=2)
        except Exception:
            pass  # Silently ignore write errors

    def get_name(self) -> str:
        """
        Return unique behavior identifier.

        This name is used for logging and identification.

        Returns:
            Behavior name string (e.g., "DockerBehavior")
        """
        return "DockerBehavior"

    def get_tools(self) -> list[dict[str, Any]]:
        """
        Return tool definitions in OpenAI function format.

        Each tool must have:
        - name: Tool identifier
        - description: What the tool does
        - parameters: JSON Schema for tool arguments

        Returns:
            List of tool definition dicts
        """
        return [
            {
                "type": "function",
                "function": {
                    "name": "docker_start_container",
                    "description": "Start a Docker container and track its state",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "image": {
                                "type": "string",
                                "description": "Docker image name"
                            },
                            "name": {
                                "type": "string",
                                "description": "Container name"
                            }
                        },
                        "required": ["image", "name"]
                    }
                }
            },
            {
                "type": "function",
                "function": {
                    "name": "docker_stop_container",
                    "description": "Stop a running container and update state",
                    "parameters": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Container name to stop"
                            }
                        },
                        "required": ["name"]
                    }
                }
            },
            {
                "type": "function",
                "function": {
                    "name": "docker_list_containers",
                    "description": "List all tracked containers with their status",
                    "parameters": {
                        "type": "object",
                        "properties": {}
                    },
                    "required": []
                }
            }
        ]

    def dispatch_tool(
        self,
        agent: Any,
        tool_name: str,
        args: dict[str, Any]
    ) -> dict[str, Any]:
        """
        Execute tool by name.

        Args:
            agent: Agent instance (access workspace, state, etc.)
            tool_name: Name of tool to execute
            args: Tool arguments from LLM

        Returns:
            Result dict with either:
            - {"result": value, "success": True} on success
            - {"error": message} on failure
        """
        if tool_name == "docker_start_container":
            try:
                image = args.get("image")
                name = args.get("name")
                if not image or not name:
                    raise ValueError("Both 'image' and 'name' are required.")
                container_id = self._start_container(image, name)
                self.containers[name] = {"id": container_id, "status": "running"}
                return {"result": container_id, "success": True}
            except Exception as e:
                return {"error": str(e)}

        if tool_name == "docker_stop_container":
            try:
                name = args.get("name")
                if not name:
                    raise ValueError("'name' is required.")
                self._stop_container(name)
                if name in self.containers:
                    self.containers[name]["status"] = "stopped"
                return {"result": f"Container '{name}' stopped.", "success": True}
            except Exception as e:
                return {"error": str(e)}

        if tool_name == "docker_list_containers":
            try:
                containers = self._list_containers()
                return {"result": containers, "success": True}
            except Exception as e:
                return {"error": str(e)}

        return super().dispatch_tool(agent, tool_name, args)

    def _start_container(self, image: str, name: str) -> str:
        """
        Start a Docker container using subprocess and return its ID.
        """
        cmd = ["docker", "run", "-d", "--name", name, image]
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        container_id = result.stdout.strip()
        if not container_id:
            raise RuntimeError("Failed to retrieve container ID.")
        return container_id

    def _stop_container(self, name: str):
        """
        Stop a Docker container using subprocess.
        """
        cmd = ["docker", "stop", name]
        subprocess.run(cmd, capture_output=True, text=True, check=True)

    def _list_containers(self) -> list[dict[str, str]]:
        """
        Return the list of tracked containers with their status.
        """
        return [
            {"name": name, "id": info["id"], "status": info["status"]}
            for name, info in self.containers.items()
        ]

    # OPTIONAL: Override lifecycle hooks if needed

    def on_initial_context(
        self,
        agent: Any,
        context: list[dict[str, Any]]
    ) -> list[dict[str, Any]]:
