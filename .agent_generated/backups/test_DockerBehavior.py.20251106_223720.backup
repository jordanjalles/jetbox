def test_list_containers_success(behavior, monkeypatch):
    """Test that listing containers returns the expected list."""
    # Mock the internal Docker call to return a list of container dicts
    mock_list = MagicMock(return_value=[
        {"Name": "web_server", "Status": "running"},
        {"Name": "db", "Status": "stopped"},
    ])
    monkeypatch.setattr(behavior, "_docker_list_containers", mock_list)

    result = behavior.list_containers()
    assert isinstance(result, list)
    assert len(result) == 2
    assert result[0]["Name"] == "web_server"
    assert result[1]["Status"] == "stopped"
    mock_list.assert_called_once_with()


