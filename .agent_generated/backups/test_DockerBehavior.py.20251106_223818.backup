    mock_container2 = mock.Mock()
    mock_container2.name = "c2"
    mock_container2.status = "exited"

    # Configure the mock client to return the mock containers when list is called
    behavior.client.containers.list.return_value = [mock_container1, mock_container2]

    # Call the method under test
