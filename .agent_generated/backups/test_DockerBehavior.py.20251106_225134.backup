def test_start_container_success(docker_behavior):
    """
    Test that starting a container succeeds and updates internal state.
    """
    # Arrange
    mock_container = Mock()
    docker_behavior.client.containers.run.return_value = mock_container

    # Act
    result = docker_behavior.docker_start_container(image="nginx:latest", name="webserver")

    # Assert
    docker_behavior.client.containers.run.assert_called_once_with(
        "nginx:latest", name="webserver", detach=True
    )
    assert result is mock_container
    assert docker_behavior.containers["webserver"] == "running"


def test_start_container_error(docker_behavior):
    """
    Test that starting a container handles errors from the Docker client.
    """
    # Arrange
    from docker.errors import APIError

    docker_behavior.client.containers.run.side_effect = APIError("Docker API error")

    # Act & Assert
    with pytest.raises(APIError, match="Docker API error"):
        docker_behavior.docker_start_container(image="nginx:latest", name="webserver")

    # Ensure state was not updated
    assert "webserver" not in docker_behavior.containers


def test_stop_container_success(docker_behavior):
    """
    Test that stopping a container succeeds and updates internal state.
    """
    # Arrange
    mock_container = Mock()
    docker_behavior.client.containers.get.return_value = mock_container
    docker_behavior.containers["webserver"] = "running"

    # Act
    result = docker_behavior.docker_stop_container(name="webserver")

    # Assert
    docker_behavior.client.containers.get.assert_called_once_with("webserver")
    mock_container.stop.assert_called_once()
    assert result is mock_container
    assert docker_behavior.containers["webserver"] == "stopped"


def test_stop_container_error_not_found(docker_behavior):
    """
    Test that stopping a non-existent container raises an error.
    """
    # Arrange
    from docker.errors import NotFound

    docker_behavior.client.containers.get.side_effect = NotFound("Container not found")

    # Act & Assert
    with pytest.raises(NotFound, match="Container not found"):
        docker_behavior.docker_stop_container(name="missing")

    # Ensure state was not updated
    assert "missing" not in docker_behavior.containers


def test_list_containers_success(docker_behavior):
    """
    Test that listing containers returns the correct state information.
    """
    # Arrange
    docker_behavior.containers = {
        "webserver": "running",
        "db": "stopped",
    }

    # Act
    result = docker_behavior.docker_list_containers()

    # Assert
    expected = [
        {"name": "webserver", "status": "running"},
        {"name": "db", "status": "stopped"},
    ]
    assert result == expected


def test_list_containers_error(docker_behavior):
    """
    Test that an error during listing containers propagates correctly.
    """
    # Arrange
    from docker.errors import APIError

    docker_behavior.client.containers.list.side_effect = APIError("Listing failed")

    # Act & Assert
    with pytest.raises(APIError, match="Listing failed"):
        docker_behavior.docker_list_containers()