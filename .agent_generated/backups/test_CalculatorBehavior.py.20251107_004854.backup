# ---------- Add Tool Tests ----------

def test_add_success(calculator):
    """Test that the add tool returns the correct sum for valid numeric inputs."""
    result = calculator.add(a=3, b=5)
    assert result == 8, f"Expected 8, got {result}"


def test_add_with_negative_numbers(calculator):
    """Test addition with negative numbers."""
    result = calculator.add(a=-4, b=2)
    assert result == -2, f"Expected -2, got {result}"


def test_add_with_floats(calculator):
    """Test addition with floating point numbers."""
    result = calculator.add(a=2.5, b=3.1)
    assert pytest.approx(result, 0.0001) == 5.6, f"Expected approx 5.6, got {result}"


def test_add_missing_argument(calculator):
    """Test that calling add without required arguments raises TypeError."""
    with pytest.raises(TypeError):
        calculator.add(a=1)  # Missing 'b'


def test_add_invalid_type(calculator):
    """Test that passing non-numeric types raises a ValueError."""
    with pytest.raises(ValueError):
        calculator.add(a="foo", b=2)


# ---------- Subtract Tool Tests ----------

def test_subtract_success(calculator):
    """Test that the subtract tool returns the correct difference for valid numeric inputs."""
    result = calculator.subtract(a=10, b=4)
    assert result == 6, f"Expected 6, got {result}"


def test_subtract_with_negative_numbers(calculator):
    """Test subtraction with negative numbers."""
    result = calculator.subtract(a=-5, b=-3)
    assert result == -2, f"Expected -2, got {result}"


def test_subtract_with_floats(calculator):
    """Test subtraction with floating point numbers."""
    result = calculator.subtract(a=5.5, b=2.2)
    assert pytest.approx(result, 0.0001) == 3.3, f"Expected approx 3.3, got {result}"


def test_subtract_missing_argument(calculator):
    """Test that calling subtract without required arguments raises TypeError."""
    with pytest.raises(TypeError):
        calculator.subtract(b=2)  # Missing 'a'


def test_subtract_invalid_type(calculator):
    """Test that passing non-numeric types raises a ValueError."""
    with pytest.raises(ValueError):
        calculator.subtract(a=5, b="bar")